{
	"schemaVersion": 1,
	"id": "npc-puppetmaster",
	"version": "${version}",
	"name": "NPC Puppetmaster",
	"description": "Control and possess Easy NPCs using Figura avatars!",
	"authors": [
		"Asinphi"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/npc-puppetmaster/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.asinphi.npcpuppetmaster.NPCPuppetmaster"
		],
		"client": [
			"io.asinphi.npcpuppetmaster.NPCPuppetmasterClient"
		],
		"fabric-datagen": [
			"io.asinphi.npcpuppetmaster.NPCPuppetmasterDataGenerator"
		]
	},
	"mixins": [
		"npc-puppetmaster.mixins.json",
		{
			"config": "npc-puppetmaster.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"easy_npc": ">=6.2.0",
        "npc-avatar": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}